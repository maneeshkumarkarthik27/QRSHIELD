# QRShield Backend Service Environment Configuration Template
# Copy this file to backend/.env and provide real credentials when backend integration is enabled.
# NEVER commit backend/.env to source control.

# Layer 1: Google Safe Browsing Lookup API (v4 / Web Risk)
GOOGLE_SAFE_BROWSING_API_KEY=

# Layer 4: Google Gemini Threat Analyst API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Layer 3: Docker Playwright sandbox
SANDBOX_CONTAINER_RUNTIME=docker
SANDBOX_TIMEOUT_MS=15000
SANDBOX_ALLOW_EGRESS=false
SANDBOX_PORT=4892

# Service Configuration
QRSHIELD_BACKEND_PORT=4892
QRSHIELD_BACKEND_HOST=127.0.0.1
QRSHIELD_ENV=development
