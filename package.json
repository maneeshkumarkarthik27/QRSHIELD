{
  "name": "qrshield",
  "private": true,
  "version": "1.0.0",
  "description": "QRShield — Global Windows Security & Four-Layer Link Analysis",
  "author": "QRShield Security Architect",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:helper": "powershell -Command \"& 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\MSBuild.exe' windows-helper/QRShieldHelper.csproj /p:Configuration=Release /p:Platform=x64\"",
    "sandbox:build": "docker compose -f backend/docker-compose.yml build",
    "sandbox:start": "docker compose -f backend/docker-compose.yml up -d",
    "sandbox:stop": "docker compose -f backend/docker-compose.yml down",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:ui": "tsc && vite build",
    "build:all": "npm run build:helper && npm run build:ui && npm run build:electron",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && cross-env NODE_ENV=development electron .\"",
    "dist": "npm run build:all && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.qrshield.security",
    "productName": "QRShield",
    "copyright": "Copyright © 2026 QRShield Security",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "windows-helper/bin/Release/QRShieldHelper.exe",
        "to": "bin/QRShieldHelper.exe"
      },
      {
        "from": "backend",
        "to": "sandbox",
        "filter": [
          "Dockerfile",
          "docker-compose.yml",
          "package.json",
          "sandbox-server.mjs"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QRShield",
      "uninstallDisplayName": "QRShield Windows Protection",
      "runAfterFinish": true
    }
  }
}
